{
  feature_id: "defaultSecondaryAudioLanguage",
  fallback_value: null,
  options: [
    {
      when_all: [
        { in: ["countryCode", "DK", "FI", "SE", "NO", "IE", "FR", "DE", "NL", "ES", "IT",
               "PL", "AT", "BE", "CH", "HR", "CZ", "RO", "PT", "SK", "RS", "HU", "LU"] }
      ],
      return_value: "en"
    }
  ]
}
