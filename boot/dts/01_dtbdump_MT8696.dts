			iommus = <0x19 0x00 0x19 0x01 0x19 0x02 0x19 0x03 0x19 0x80 0x19 0x81 0x19 0x82 0x19 0x83 0x19 0x84 0x19 0x85 0x19 0x86 0x19 0x87 0x19 0x88 0x19 0x89 0x19 0x8a 0x19 0xa0 0x19 0xa1 0x19 0xa2 0x19 0xa3 0x19 0xa4 0x19 0xa5 0x19 0xa6 0x19 0xa7 0x19 0xa8 0x19 0xa9 0x19 0xaa 0x19 0xab 0x19 0xac 0x19 0xad 0x19 0xae 0x19 0xc0 0x19 0xc1 0x19 0xc2 0x19 0xc3 0x19 0xc4 0x19 0xc5 0x19 0xc6 0x19 0xc7 0x19 0xc8 0x19 0xc9 0x19 0xca 0x19 0xcb 0x19 0xcc 0x19 0xcd 0x19 0xce 0x19 0xcf 0x19 0xd0>;
			mediatek,larb = <0x11 0x14 0x15 0x16>;
			mboxes = <0x26 0x04 0xffffffff 0x01 0x26 0x05 0xffffffff 0x04 0x26 0x00 0x00 0x04>;
			phandle = <0x8d>;
		};

		pseudo-m4u {
			compatible = "mediatek,mtk-pseudo-m4u";
			iommus = <0x19 0xab>;
		};
	};

	mtee {
		compatible = "mediatek,mtee";
		clocks = <0x0c 0x9f>;
		clock-names = "GCPU_B";
	};

	optee {
		compatible = "linaro,optee-tz";
		method = "smc";
		clocks = <0x0c 0xa0>;
		clock-names = "ECC";
	};

	clkao {
		compatible = "simple-bus";
		status = "okay";
		phandle = <0x8e>;
	};

	lastpc {
		compatible = "mediatek,lastpc";
		phandle = <0x8f>;
	};

	dfd_mcu {
		compatible = "mediatek,dfd";
		mediatek,enabled = <0x01>;
		mediatek,chain_length = <0x54e8>;
		mediatek,rg_dfd_timeout = <0xa0>;
		mediatek,check_dfd_support = <0x01>;
		phandle = <0x90>;
	};

	dfd_cache {
		compatible = "mediatek,dfd_cache";
		enabled = <0x00>;
		rg_dfd_timeout = <0x5dc0>;
		phandle = <0x91>;
	};

	sound {
		compatible = "mediatek,mt8696-evb";
		mediatek,platform = <0x2b>;
		status = "okay";
		phandle = <0x92>;
	};

	sound1 {
		compatible = "mediatek,mt8696-card1";
		mediatek,platform = <0x2c>;
		mediatek,multi-in-audio-codec = <0x2d>;
		mediatek,multi-in-codec-dai-name = "mtk-earc-rx-codec-dai";
		power-domains = <0x1e 0x0a>;
		status = "okay";
		phandle = <0x93>;
	};

	odm {
		compatible = "simple-bus";
		phandle = <0x94>;
	};

	thermal-zones {
		phandle = <0x95>;
	};

