<?xml version="1.0" encoding="utf-8"?>
<permissions>
    <!-- Guideline for AOSP: https://wiki.labcollab.net/confluence/pages/viewpage.action?pageId=2320007235 -->
    <privapp-permissions package="com.amazon.tv.matter">
        <!-- Allows modification of secure system settings, such as enabling/disabling system features. -->
        <permission name="android.permission.WRITE_SECURE_SETTINGS"/>
        <!-- Allows control over media playback, volume, and media sessions on the device. -->
        <permission name="android.permission.MEDIA_CONTENT_CONTROL"/>
        <!-- Grants access to privileged phone state data, such as device identifiers and network information. -->
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE"/>
        <!-- Enables interaction with HDMI-connected devices using CEC -->
        <permission name="android.permission.HDMI_CEC"/>
        <!-- Enables starting foreground pincode UI screens -->
        <permission name="android.permission.START_FOREGROUND_SERVICES_FROM_BACKGROUND"/>
        <!-- Enables starting foreground pincode UI screens -->
        <permission name="android.permission.START_ACTIVITIES_FROM_BACKGROUND"/>
    </privapp-permissions>
</permissions>