on post-fs-data
    mkdir /data/misc/cloud_pairing
    chown root root /data/misc/cloud_pairing
    chmod 0700 /data/misc/cloud_pairing

on property:persist.cloudpairing.emptylist=0
    start cloudpairingd

on property:persist.cloudpairing.emptylist=1
    stop cloudpairingd

service cloudpairingd /system/system_ext/bin/cloud_pairing_service
    class main
    user root
    group root inet
    disabled
    oneshot
