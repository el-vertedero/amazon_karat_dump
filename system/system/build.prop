#
# system.prop for generic sdk
#

vendor.rild.libpath=mtk-ril.so
vendor.rild.libargs=-d /dev/ttyC0


# MTK, Infinity, 20090720 {
wifi.interface=wlan0
# MTK, Infinity, 20090720 }

# MTK, mtk03034, 20101210 {
ro.mediatek.wlan.wsc=1
# MTK, mtk03034 20101210}
# MTK, mtk03034, 20110318 {
ro.mediatek.wlan.p2p=1
# MTK, mtk03034 20110318}

# MTK, mtk03034, 20101213 {
mediatek.wlan.ctia=0
# MTK, mtk03034 20101213}


#
wifi.tethering.interface=ap0
#

ro.opengles.version=196610
#ro.kernel.qemu=1
#ro.kernel.qemu.gles=0

wifi.direct.interface=p2p0
#dalvik.vm.heapgrowthlimit=256m
#dalvik.vm.heapsize=512m

# USB MTP WHQL
ro.sys.usb.mtp.whql.enable=0
ro.vendor.usb.vid=0x1949


ro.sys.usb.storage.type=mtp

# USB BICR function
ro.sys.usb.bicr=no

# USB Charge only function
ro.sys.usb.charging.only=yes

# audio
ro.camera.sound.forced=0
ro.audio.silent=0

ro.zygote.preload.enable=0

# temporary enables NAV bar (soft keys)
qemu.hw.mainkeys=0

ro.kernel.zio=38,108,105,16
#ro.kernel.qemu=1
#ro.kernel.qemu.gles=0
#ro.boot.selinux=disable

# Disable dirty region for Mali
#debug.hwui.render_dirty_regions=false

# FB Gralloc optimization
ro.fos.gralloc.flags=0x00000200

# Default value of (persist.sys.boot.reason) after first flash boot OR
# first boot after factory reset in /system/build.prop
persist.sys.boot.reason="reboot,"
persist.sys.bootanim.boot.reason="reboot,"

# Use this property to configure AudioFlinger to choose the Normal mixer path
# when the HAL buffer size is more than or equal to the size mentioned
audio.af.min.normalsink.bufsize.ms=16

# When this is true, the AudioTrack::write() calls gets unblocked as soon as
# there is sufficient space is available in the shared buffer (cblk) instead
# of waiting for half of the shared buffer to become free
audio.af.enable.cblk.write.delay.optimization=true

# Use the property to configure if Dolby MS12 is supported.
persist.dolby.ms12.proxy.disable=0

## First time no bootanimation audio after full flash or factory reset
# Use non-zero default volume for system stream to ensure audio is not muted
# when boot animation starts before the AudioService (SystemServer) initializes
# SystemServer init for first boot takes longer time and AudioService
# full init is block on that.
ro.config.system_vol_default=7

# Config AOSP AAC decoder reference level to -24dBFS for US market RF mode
aac_drc_reference_level=96

# performance
ro.mtk_perf_simple_start_win=1
ro.mtk_perf_fast_start_win=1
ro.mtk_perf_response_time=1

# can't disbale bootanimation on FOS build
# if MTK need this, they need to do somewhere else
# FPGA workaround - disable bootanimation
#debug.sf.nobootanimation=1

# Storage
ro.storaged.event.interval=999999

# Define ARC port
ro.hdmi.property_sytem_audio_device_arc_port=com.mediatek.tvinput/.ARCInputService/HW1

# Reserve WHA server ports.
vendor.sysctl.ip_loc_res_ports=55442-55445

# Do not turn BT off during WHA playback.
persist.amzn.wha.bt_disable=false

#declare hdr to sdr support to avoid GPU composition by SF
ro.vendor.mtk_hdr_video_support=1

# Declare the device a cec switch to allow for automatic input switching
ro.hdmi.property_is_device_hdmi_cec_switch=true

# Enable HDMI-CEC framework logging
log.tag.HDMI=DEBUG

# Enable IME binding cgroup boost
persist.sys.amzncgs.boostIME=true
# end of device/amazon/karat/system.prop

