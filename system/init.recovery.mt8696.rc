on init
    mkdir /config
    setprop sys.usb.ffs.aio_compat 1
    setprop sys.usb.controller "11201000.usb"
    setprop sys.usb.configfs 1

on boot
    write /config/usb_gadget/g1/idVendor  0x0e8d
    write /config/usb_gadget/g1/idProduct 0x201c

on fs
    symlink /dev/block/platform/soc/11230000.mmc /dev/block/platform/bootdevice
    write /sys/block/mmcblk0boot0/force_ro 0

on post-fs
    # Support A/B feature for EMMC and UFS boot region
    wait /dev/block/mmcblk0boot0 2
    symlink /dev/block/sda /dev/block/mmcblk0boot0
    symlink /dev/block/sdb /dev/block/mmcblk0boot1
    symlink /dev/block/mmcblk0boot0 /dev/block/platform/soc/bootdevice/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/platform/soc/bootdevice/by-name/preloader_b
    symlink /dev/block/mmcblk0boot0 /dev/block/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/by-name/preloader_b

    # Support A/B feature for combo emmc and ufs OTA update
    symlink /dev/block/platform/soc/bootdevice/by-name/preloader_a /dev/block/platform/soc/bootdevice/by-name/preloader_emmc_a
    symlink /dev/block/platform/soc/bootdevice/by-name/preloader_b /dev/block/platform/soc/bootdevice/by-name/preloader_emmc_b
    symlink /dev/block/platform/soc/bootdevice/by-name/preloader_a /dev/block/platform/soc/bootdevice/by-name/preloader_ufs_a
    symlink /dev/block/platform/soc/bootdevice/by-name/preloader_b /dev/block/platform/soc/bootdevice/by-name/preloader_ufs_b

    # Support A/B feature for combo emmc and ufs OTA update
    symlink /dev/block/platform/soc/bootdevice/by-name/preloader_a /dev/block/by-name/preloader_emmc_a
    symlink /dev/block/platform/soc/bootdevice/by-name/preloader_b /dev/block/by-name/preloader_emmc_b
    symlink /dev/block/platform/soc/bootdevice/by-name/preloader_a /dev/block/by-name/preloader_ufs_a
    symlink /dev/block/platform/soc/bootdevice/by-name/preloader_b /dev/block/by-name/preloader_ufs_b

    exec u:r:update_engine:s0 root root -- /system/bin/mtk_plpath_utils


# Configfs triggers
on property:sys.usb.config=sideload && property:sys.usb.ffs.ready=1 && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idProduct 0x201c

on property:sys.usb.config=adb && property:sys.usb.ffs.ready=1 && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idProduct 0x201c

on property:sys.usb.config=fastboot && property:sys.usb.ffs.ready=1 && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idProduct 0x201c

# enable console in recovery mode
service console /system/bin/sh
    user root
    group root
    class core
    console
    disabled
    user shell
    group shell log readproc
    seclabel u:r:shell:s0
    setenv HOSTNAME console

on boot
    start console
