/dts-v1/;

/ {
	model = "MT8696";
	compatible = "mediatek,mt8696";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;

	extcon_iddig {
		compatible = "linux,extcon-usb-gpio";
		status = "disabled";
		phandle = <0x2e>;
	};

	mediatek,mt7921-wifi {
		compatible = "mediatek,mediatek_wifi_ctrl";
		interrupt-parent = <0x02>;
		interrupts = <0x0b 0x08 0x00 0x00>;
		status = "okay";
	};

	mediatek,mt7921-bt {
		compatible = "mediatek,woble_eint";
		interrupt-parent = <0x02>;
		interrupts = <0x0c 0x08 0x01 0x00>;
		status = "okay";
	};

	thermal-sensor {
		compatible = "generic-adc-thermal";
		#thermal-sensor-cells = <0x00>;
		io-channels = <0x03 0x00 0x03 0x01 0x03 0x02>;
		io-channel-names = "sensor-channel";
		phandle = <0x2f>;
	};

	fixedregulator@0 {
		compatible = "regulator-fixed";
		regulator-name = "mmc_power";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		enable-active-high;
		phandle = <0x30>;
	};

	fixedregulator@1 {
		compatible = "regulator-fixed";
		regulator-name = "mmc_io";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		enable-active-high;
		phandle = <0x31>;
	};

	fixedregulator@2 {
		compatible = "regulator-fixed";
		regulator-name = "sdio_power";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		enable-active-high;
		regulator-always-on;
		phandle = <0x32>;
	};

	fixedregulator@3 {
		compatible = "regulator-fixed";
		regulator-name = "sdio_pmu";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		startup-delay-us = <0x30d40>;
		gpio = <0x02 0x1a 0x00>;
		enable-active-high;
		phandle = <0x33>;
	};

	fixedregulator@4 {
		compatible = "regulator-fixed";
		regulator-name = "vbus";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		regulator-type = "voltage";
		regulator-always-on;
		phandle = <0x34>;
	};

	fixedregulator@5 {
		compatible = "regulator-fixed";
		regulator-name = "usb vbus";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		regulator-always-on;
		phandle = <0x35>;
	};

	aliases {
		i2c0 = "/soc/i2c@11007000";
		i2c1 = "/soc/i2c@11008000";
		i2c2 = "/soc/i2c@11009000";
		i2c3 = "/soc/i2c@11010000";
		i2c4 = "/soc/i2c@10018000";
		i2c5 = "/soc/i2c@11011000";
	};

	chosen {
		bootargs = "console=tty0 console=ttyS1,921600n1 earlycon=uart8250,mmio32,0x11002400 root=/dev/ram  vmalloc=300M androidboot.hardware=mt8696 loop.max_part=7";
		kaslr-seed = <0x00 0x00>;
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		#cooling-cells = <0x02>;
		phandle = <0x36>;

		cpu@000 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x04 0x05 0x06>;
			performance-domains = <0x07 0x00>;
			clock-frequency = <0x6553f100>;
			#cooling-cells = <0x02>;
			phandle = <0x08>;
		};

		cpu@001 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x100>;
			enable-method = "psci";
			cpu-idle-states = <0x04 0x05 0x06>;
			performance-domains = <0x07 0x00>;
			clock-frequency = <0x6553f100>;
			#cooling-cells = <0x02>;
			phandle = <0x09>;
		};

		cpu@002 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x200>;
			enable-method = "psci";
			cpu-idle-states = <0x04 0x05 0x06>;
			performance-domains = <0x07 0x00>;
			clock-frequency = <0x6553f100>;
			#cooling-cells = <0x02>;
			phandle = <0x0a>;
		};

		cpu@003 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x300>;
			enable-method = "psci";
			cpu-idle-states = <0x04 0x05 0x06>;
			performance-domains = <0x07 0x00>;
			clock-frequency = <0x6553f100>;
			#cooling-cells = <0x02>;
			phandle = <0x0b>;
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x08>;
				};

				core1 {
					cpu = <0x09>;
				};

				core2 {
					cpu = <0x0a>;
				};

				core3 {
					cpu = <0x0b>;
				};
			};
		};

		idle-states {
			entry-method = "psci";

			cpuoff {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x10001>;
				entry-latency-us = <0x64>;
				exit-latency-us = <0xfa>;
				min-residency-us = <0x640>;
				phandle = <0x04>;
			};

			clusteroff {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x1010001>;
				entry-latency-us = <0x64>;
				exit-latency-us = <0x15e>;
				min-residency-us = <0x834>;
				phandle = <0x05>;
			};

			mcusysoff {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x1010007>;
				entry-latency-us = <0x12c>;
				exit-latency-us = <0x4b0>;
				min-residency-us = <0xa28>;
				phandle = <0x06>;
			};
		};
	};

	clocks {

		clk_null {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x00>;
			phandle = <0x37>;
		};

		clk26m {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x18cba80>;
			clock-output-names = "clk26m";
			phandle = <0x1b>;
		};

		clk13m {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0xc65d40>;
			phandle = <0x0e>;
		};

		clk12m {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0xb71b00>;
			phandle = <0x38>;
		};

		clk32k {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x8000>;
			clock-output-names = "clk32k";
			phandle = <0x39>;
		};

		oscillator@0 {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x2ee0000>;
			clock-output-names = "i2si0_mck_i";
			phandle = <0x3a>;
		};

		oscillator@1 {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x2ee0000>;
			clock-output-names = "splin_mck_i";
			phandle = <0x3b>;
		};
	};

	firmware {
		phandle = <0x3c>;

		android {
			compatible = "android,firmware";
			phandle = <0x3d>;

			fstab {
				compatible = "android,fstab";
				phandle = <0x3e>;
			};
		};
	};

	pmu {
		compatible = "arm,cortex-a55-pmu\0arm,cortex-a7-pmu";
		interrupt-parent = <0x01>;
		interrupts = <0x01 0x07 0x04>;
	};

	pmu-dsu-0 {
		compatible = "arm,dsu-pmu";
		interrupts = <0x00 0x12 0x04>;
		cpus = <0x08 0x09 0x0a 0x0b>;
		limit_latency = <0x154>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x00 0x40000000 0x00 0x20000000>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0x3f>;

		atf-reserved-memory@a3000000 {
			compatible = "mediatek,mt8696-atf-reserved-memory";
			no-map;
			reg = <0x00 0xa3000000 0x00 0x100000>;
			phandle = <0x40>;
		};

		optee-reserved-memory@a3100000 {
			compatible = "mediatek,mt8696-optee-reserved-memory";
			no-map;
			reg = <0x00 0xa3100000 0x00 0x13200000>;
			phandle = <0x41>;
		};

		atf_aee_log_reserved_mem@57240000 {
			compatible = "mediatek,mt8696-atf-aee-log";
			reg = <0x00 0x57240000 0x00 0x4000>;
			phandle = <0x42>;
		};

		mboot_params-reserved-memory@59400000 {
			compatible = "mediatek,mboot_params";
			reg = <0x00 0x59400000 0x00 0x10000>;
			phandle = <0x43>;
		};

		ramoops@59410000 {
			compatible = "ramoops";
			reg = <0x00 0x59410000 0x00 0xe0000>;
			console-size = <0x40000>;
			pmsg-size = <0x10000>;
			phandle = <0x44>;
		};

		minirdump-reserved-memory@594f0000 {
			compatible = "mediatek,minirdump";
			reg = <0x00 0x594f0000 0x00 0x10000>;
			phandle = <0x45>;
		};

		mrdump_cb_reserved_memory@59500000 {
			compatible = "mediatek,mrdump_cb";
			reg = <0x00 0x59500000 0x00 0x2000>;
			phandle = <0x46>;
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <0x01>;
		interrupts = <0x01 0x0d 0x04 0x01 0x0e 0x04 0x01 0x0b 0x04 0x01 0x0a 0x04>;
		phandle = <0x47>;
	};

	soc {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "simple-bus";
		ranges;

		performance-controller@10bc10 {
			compatible = "mediatek,cpufreq-hw";
			reg = <0x00 0x10bc10 0x00 0x120>;
			#performance-domain-cells = <0x01>;
			phandle = <0x07>;
		};

		scp@338000 {
			compatible = "mediatek,mt8696-scp";
			reg = <0x00 0x280000 0x00 0x7f000 0x00 0x338000 0x00 0x1000 0x00 0x2ff000 0x00 0x100 0x00 0x33a000 0x00 0x04 0x00 0x33a00c 0x00 0x04 0x00 0x2ff100 0x00 0x100 0x00 0x33b000 0x00 0x04 0x00 0x33b00c 0x00 0x04 0x00 0x2ff200 0x00 0x100 0x00 0x33c000 0x00 0x04 0x00 0x33c00c 0x00 0x04 0x00 0x2ff300 0x00 0x100 0x00 0x33d000 0x00 0x04 0x00 0x33d00c 0x00 0x04 0x00 0x2ff400 0x00 0x100 0x00 0x33e000 0x00 0x04 0x00 0x33e00c 0x00 0x04>;
			reg-names = "sram\0cfg\0mbox0_base\0mbox0_set\0mbox0_clr\0mbox1_base\0mbox1_set\0mbox1_clr\0mbox2_base\0mbox2_set\0mbox2_clr\0mbox3_base\0mbox3_set\0mbox3_clr\0mbox4_base\0mbox4_set\0mbox4_clr";
			interrupts = <0x00 0x93 0x04 0x00 0x95 0x04 0x00 0x96 0x04 0x00 0x97 0x04 0x00 0x128 0x04 0x00 0x129 0x04>;
			interrupt-names = "wdt\0mbox0\0mbox1\0mbox2\0mbox3\0mbox4";
			clocks = <0x0c 0x63>;
			clock-names = "main";
			status = "okay";
			phandle = <0x48>;
		};

		soc_data@8000000 {
			compatible = "mediatek,mt8696-efuse\0mediatek,efuse";
			reg = <0x00 0x8000000 0x00 0x10>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			phandle = <0x49>;
		};

		interrupt-controller@c000000 {
			compatible = "arm,gic-v3";
			#interrupt-cells = <0x03>;
			interrupt-parent = <0x01>;
			#redistributor-regions = <0x01>;
			interrupt-controller;
			reg = <0x00 0xc000000 0x00 0x40000 0x00 0xc040000 0x00 0x200000>;
			interrupts = <0x01 0x09 0x04>;
			phandle = <0x01>;
		};

		syscon@c53a000 {
			compatible = "mediatek,mt8696-mcucfg\0syscon";
			reg = <0x00 0xc53a000 0x00 0x1000>;
			#clock-cells = <0x01>;
			phandle = <0x4a>;
		};

		mcupm@c540000 {
			compatible = "mediatek,mcupm";
			reg = <0x00 0xc540000 0x00 0x22000 0x00 0xc55fb00 0x00 0xa0 0x00 0xc562004 0x00 0x04 0x00 0xc562018 0x00 0x04 0x00 0xc562000 0x00 0x04 0x00 0xc562010 0x00 0x04 0x00 0xc55fba0 0x00 0xa0 0x00 0xc562004 0x00 0x04 0x00 0xc562018 0x00 0x04 0x00 0xc562000 0x00 0x04 0x00 0xc562010 0x00 0x04 0x00 0xc55fc40 0x00 0xa0 0x00 0xc562004 0x00 0x04 0x00 0xc562018 0x00 0x04 0x00 0xc562000 0x00 0x04 0x00 0xc562010 0x00 0x04 0x00 0xc55fce0 0x00 0xa0 0x00 0xc562004 0x00 0x04 0x00 0xc562018 0x00 0x04 0x00 0xc562000 0x00 0x04 0x00 0xc562010 0x00 0x04 0x00 0xc55fd80 0x00 0xa0 0x00 0xc562004 0x00 0x04 0x00 0xc562018 0x00 0x04 0x00 0xc562000 0x00 0x04 0x00 0xc562010 0x00 0x04 0x00 0xc55fe20 0x00 0xa0 0x00 0xc562004 0x00 0x04 0x00 0xc562018 0x00 0x04 0x00 0xc562000 0x00 0x04 0x00 0xc562010 0x00 0x04 0x00 0xc55fec0 0x00 0xa0 0x00 0xc562004 0x00 0x04 0x00 0xc562018 0x00 0x04 0x00 0xc562000 0x00 0x04 0x00 0xc562010 0x00 0x04 0x00 0xc55ff60 0x00 0xa0 0x00 0xc562004 0x00 0x04 0x00 0xc562018 0x00 0x04 0x00 0xc562000 0x00 0x04 0x00 0xc562010 0x00 0x04>;
			reg-names = "mcupm_base\0mbox0_base\0mbox0_set\0mbox0_clr\0mbox0_send\0mbox0_recv\0mbox1_base\0mbox1_set\0mbox1_clr\0mbox1_send\0mbox1_recv\0mbox2_base\0mbox2_set\0mbox2_clr\0mbox2_send\0mbox2_recv\0mbox3_base\0mbox3_set\0mbox3_clr\0mbox3_send\0mbox3_recv\0mbox4_base\0mbox4_set\0mbox4_clr\0mbox4_send\0mbox4_recv\0mbox5_base\0mbox5_set\0mbox5_clr\0mbox5_send\0mbox5_recv\0mbox6_base\0mbox6_set\0mbox6_clr\0mbox6_send\0mbox6_recv\0mbox7_base\0mbox7_set\0mbox7_clr\0mbox7_send\0mbox7_recv";
			interrupts = <0x00 0x21 0x04 0x00 0x22 0x04 0x00 0x23 0x04 0x00 0x24 0x04 0x00 0x25 0x04 0x00 0x26 0x04 0x00 0x27 0x04 0x00 0x28 0x04>;
			interrupt-names = "mbox0\0mbox1\0mbox2\0mbox3\0mbox4\0mbox5\0mbox6\0mbox7";
			phandle = <0x4b>;
		};

		syscon@10000000 {
			compatible = "mediatek,mt8696-topckgen\0syscon";
			reg = <0x00 0x10000000 0x00 0x1000>;
			#clock-cells = <0x01>;
			phandle = <0x0c>;
		};

		syscon@10001000 {
			compatible = "mediatek,mt8696-infracfg\0syscon";
			reg = <0x00 0x10001000 0x00 0x1000>;
			#clock-cells = <0x01>;
			phandle = <0x0d>;
		};

		syscon@10003000 {
			compatible = "mediatek,mt8696-pericfg\0syscon";
			reg = <0x00 0x10003000 0x00 0x1000>;
			#clock-cells = <0x01>;
			phandle = <0x0f>;
		};

		syscfg_pctl_a@10005000 {
			compatible = "mediatek,pctl-a-syscfg\0syscon";
			reg = <0x00 0x10005000 0x00 0x1000>;
			phandle = <0x4c>;
		};

		syscon@10006000 {
			compatible = "mediatek,mt8696-scpsys\0syscon";
			#power-domain-cells = <0x01>;
			reg = <0x00 0x10006000 0x00 0x1000>;
			clocks = <0x0c 0x68 0x0c 0x69 0x0c 0x6b 0x0c 0x69 0x0c 0x6b 0x0c 0x68 0x0c 0xa8 0x0c 0x8e 0x0c 0x64 0x0d 0x0d 0x0c 0x7a 0x0c 0x9b>;
			clock-names = "mm\0vdec-0\0venc-0\0mm-0\0mm-1\0osd-0\0hdmiapb\0mmcu-0\0mmcu-1\0mmcu-2\0audio\0ether";
			infracfg = <0x0d>;
			phandle = <0x1e>;
		};

		dvfsrc@10006000 {
			compatible = "mediatek,mt8696-dvfsrc";
			reg = <0x00 0x10006000 0x00 0x1000>;
			reg-names = "dvfsrc";
			status = "disabled";
			phandle = <0x4d>;

			dvfsrc-vcore {
				regulator-name = "dvfsrc-vcore";
				regulator-min-microvolt = "\0\f5";
				regulator-max-microvolt = "\0\f5";
				regulator-always-on;
				phandle = <0x4e>;
			};

			dvfsrc-helper {
				compatible = "mediatek,dvfsrc-helper";
			};
		};

		toprgu@10007000 {
			compatible = "mediatek,mt8696-rgu\0syscon\0simple-mfd";
			reg = <0x00 0x10007000 0x00 0x1000>;
			interrupts = <0x00 0x60 0x02>;
			registered-in-atf = <0x01>;
			#reset-cells = <0x01>;
			phandle = <0x4f>;

			reboot-mode {
				compatible = "syscon-reboot-mode";
				offset = <0x24>;
				mask = <0x0f>;
				mode-charger = <0x01>;
				mode-recovery = <0x02>;
				mode-bootloader = <0x03>;
				mode-dm-verity-dev-corrupt = <0x04>;
				mode-kpoc = <0x05>;
				mode-ddr-reserve = <0x06>;
				mode-meta = <0x07>;
				mode-rpmbpk = <0x08>;
			};
		};

		stc@10008000 {
			compatible = "mediatek,gpt-stc";
			reg = <0x00 0x10008000 0x00 0x40>;
			phandle = <0x50>;
		};

		pinctrl@10005000 {
			compatible = "mediatek,mt8696-pinctrl";
			reg = <0x00 0x10005000 0x00 0x1000 0x00 0x11c30000 0x00 0x200 0x00 0x11d00000 0x00 0x200 0x00 0x11d20000 0x00 0x200 0x00 0x11e10000 0x00 0x200 0x00 0x11f40000 0x00 0x200 0x00 0x1000b000 0x00 0x1000>;
			reg-names = "gpio_base\0iocfg_lb_base\0iocfg_lt_base\0iocfg_tm_base\0iocfg_rm_base\0iocfg_tr_base\0eint";
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0x02 0x00 0x00 0x9d>;
			interrupt-controller;
			interrupts = <0x00 0xa9 0x04>;
			#interrupt-cells = <0x04>;
			phandle = <0x02>;
		};

		syscon@1000c000 {
			compatible = "mediatek,mt8696-apmixedsys\0syscon";
			reg = <0x00 0x1000c000 0x00 0x1000>;
			#clock-cells = <0x01>;
			phandle = <0x1c>;
		};

		fhctl@1000ce00 {
			compatible = "mediatek,fhctl";
			reg = <0x00 0x1000ce00 0x00 0xd4>;
		};

		irrx@1000d000 {
			compatible = "mediatek,mt8696-irrx";
			reg = <0x00 0x1000d000 0x00 0x1000>;
			interrupts = <0x00 0xb5 0x04>;
			status = "disabled";
			phandle = <0x51>;
		};

		keypad@10010000 {
			compatible = "mediatek,kp";
			reg = <0x00 0x10010000 0x00 0x1000>;
			interrupts = <0x00 0x43 0x01>;
			clocks = <0x0d 0x05>;
			clock-names = "kpd";
			phandle = <0x52>;
		};

		sys_timer@10017000 {
			compatible = "mediatek,sys_timer\0mediatek,mt6765-timer";
			reg = <0x00 0x10017000 0x00 0x1000>;
			reg-names = "sys_timer_base";
			interrupts = <0x00 0xc1 0x04>;
			clocks = <0x0e>;
		};

		i2c@10018000 {
			compatible = "mediatek,mt8696-i2c";
			reg = <0x00 0x10018000 0x00 0x90 0x00 0x11000280 0x00 0x80>;
			interrupts = <0x00 0x6f 0x04>;
			clock-div = <0x01>;
			clocks = <0x0d 0x06 0x0f 0x0a>;
			clock-names = "main\0dma";
			status = "disabled";
			phandle = <0x53>;
		};

