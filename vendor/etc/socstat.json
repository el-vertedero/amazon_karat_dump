        {
          "event": "l3d_cache_allocate",
          "name": "l3d_alloc",
          "convert_to_mb": false,
          "max_value": 50000000
        },
        {
          "event": "l3d_cache_refill",
          "name": "l3d_refill",
          "convert_to_mb": false,
          "max_value": 50000000
        },
        {
          "event": "l3d_cache_wb",
          "name": "l3d_wb",
          "convert_to_mb": false,
          "max_value": 50000000
        }
      ]
    }
  ]
