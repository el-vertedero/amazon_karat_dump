# Android fstab file.
# <src>                                                 <mnt_point>   <type>    <mnt_flags and options>                 <fs_mgr_flags>
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

#/dev/block/platform/soc/11230000.mmc/by-name/system     /        ext4   ro wait,verify=/dev/block/platform/soc/11230000.mmc/by-name/metadata,recoveryonly
system                                                  /system   ext4   ro         wait,,avb=vbmeta,logical,first_stage_mount,avb_keys=/avb/q-gsi.avbpubkey:/avb/r-gsi.avbpubkey:/avb/s-gsi.avbpubkey
vendor                                                  /vendor   ext4   ro         wait,,avb,logical,first_stage_mount
product                                                 /product  ext4   ro         wait,,avb,logical,first_stage_mount

/dev/block/by-name/userdata                             /data     ext4   noatime,nosuid,nodev,noauto_da_alloc,discard,errors=panic,inlinecrypt wait,check,formattable,quota,latemount,resize,reservedsize=128m,checkpoint=block,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,fsverity

/dev/block/by-name/cache                                /cache    ext4   noatime,nosuid,nodev,noauto_da_alloc wait,check

/devices/platform/soc/11240000.mmc*                     auto      vfat   defaults   voldmanaged=sdcard1:auto,encryptable=userdata
/devices/platform/soc/11201000.usb*                     auto      vfat   defaults   voldmanaged=usbotg:auto,encryptable=userdata

/dev/block/platform/soc/11230000.mmc/by-name/MISC       /misc     emmc   defaults   defaults

# patch for not exists in fstab issue
/dev/block/by-name/dtbo /dtbo emmc defaults defaults
/dev/block/by-name/lk /bootloader emmc defaults defaults
/dev/block/by-name/lk2 /bootloader2 emmc defaults defaults
/dev/block/by-name/vbmeta /vbmeta emmc defaults defaults
